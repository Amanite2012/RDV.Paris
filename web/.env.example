# Configuration du site RDV.Paris : copiez ce fichier en `.env` (ignoré par git) et complétez-le.
# Chargement : `node --env-file=.env web/server.js`, ou `env_file:` dans docker compose.

# Adresse publique du site (sert aux liens des e-mails et au retour de Google). En production : https.
BASE_URL=https://rdv.example.fr
PORT=3100
# 127.0.0.1 derrière un proxy (nginx) sur la même machine, 0.0.0.0 dans un conteneur.
HOST=127.0.0.1
# Derrière nginx : lire l'adresse du visiteur dans X-Forwarded-For (limitation des tentatives).
TRUST_PROXY=1
# Dossier des données (db.json, secret.key). À sauvegarder.
DATA_DIR=./data

# Clé de chiffrement des liens d'agenda et des jetons Google (32 caractères ou plus).
# Si elle est absente, une clé est créée dans DATA_DIR/secret.key. Ne la perdez pas.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_SECRET=

# --- Connexion Google et Google Agenda (facultatif) --------------------------------------------
# Google Cloud Console → API et services → Identifiants → ID client OAuth (Application Web).
# URI de redirection autorisé : <BASE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- E-mails (facultatif : lien de connexion par e-mail et notifications) ------------------------
# Gmail : mot de passe d'application (compte avec validation en deux étapes), environ 500 e-mails/jour.
#   SMTP_URL=smtps://votre.adresse%40gmail.com:motdepassedapplication@smtp.gmail.com:465
# Ou un service d'envoi (Brevo, Resend, Mailjet…) avec ses identifiants SMTP.
SMTP_URL=
MAIL_FROM=RDV.Paris <votre.adresse@gmail.com>
# Vérification des notifications (minutes, 10 minimum).
NOTIFY_INTERVAL_MIN=30

# --- Développement uniquement ----------------------------------------------------------------
# Connexion sans vérification (refusée si BASE_URL n'est pas http://localhost) et e-mails dans la console.
# DEV_LOGIN=1
# MAIL_TRANSPORT=console
